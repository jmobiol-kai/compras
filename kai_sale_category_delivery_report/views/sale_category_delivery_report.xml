<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_kai_sale_category_delivery" model="ir.actions.report">
        <field name="name">Productos por categoría y fecha de entrega</field>
        <field name="model">kai.sale.category.delivery.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">kai_sale_category_delivery_report.report_kai_sale_category_delivery</field>
        <field name="report_file">kai_sale_category_delivery_report.report_kai_sale_category_delivery</field>
        <field name="print_report_name">'Productos_%s' % (object.delivery_date)</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="report_kai_sale_category_delivery">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Productos por categoría y fecha de entrega</h2>
                        <p>
                            <strong>Fecha de entrega:</strong>
                            <span t-field="o.delivery_date"/>
                            <br/>
                            <strong>Categorías:</strong>
                            <span t-out="', '.join(o.categ_ids.mapped('display_name'))"/>
                            <br/>
                            <strong>Pedidos:</strong>
                            <span t-if="o.include_draft">Confirmados y presupuestos</span>
                            <span t-else="">Solo confirmados (sale y done)</span>
                            <t t-if="o.partner_id">
                                <br/>
                                <strong>Proveedor:</strong>
                                <span t-field="o.partner_id"/>
                            </t>
                        </p>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Referencia</th>
                                    <th>Producto</th>
                                    <th>Categoría</th>
                                    <th>UdM</th>
                                    <th class="text-end">Cantidad</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="line">
                                    <td><span t-field="line.default_code"/></td>
                                    <td><span t-field="line.product_name"/></td>
                                    <td><span t-field="line.categ_id"/></td>
                                    <td><span t-field="line.product_uom_id"/></td>
                                    <td class="text-end"><span t-field="line.quantity"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
