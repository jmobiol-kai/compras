<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_sale_trace" model="ir.ui.view">
        <field name="name">purchase.order.form.kai.sale.trace</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <button name="button_cancel" position="after">
                <button name="action_kai_undo_sale_trace" type="object"
                        string="Anular y deshacer"
                        groups="purchase.group_purchase_user"
                        invisible="not kai_allocation_ids or state not in ('draft', 'sent', 'cancel')"
                        confirm="Se cancela la cotización si sigue abierta, se borran sus productos y los vínculos con ventas, y vuelve a borrador con el mismo número. El proveedor pasa a Consumidor Final Anónimo. No se borran las ventas ni esta orden, ni la referencia de proveedor. Después se puede volver a usar."/>
            </button>
            <div name="button_box" position="inside">
                <button name="action_view_kai_source_sales" type="object"
                        class="oe_stat_button" icon="fa-pencil-square-o"
                        groups="sales_team.group_sale_salesman"
                        invisible="kai_sale_order_count == 0">
                    <field name="kai_sale_order_count" widget="statinfo" string="Ventas origen"/>
                </button>
            </div>
            <notebook position="inside">
                <page string="Ventas origen" name="kai_sale_trace"
                      groups="sales_team.group_sale_salesman"
                      invisible="not kai_allocation_ids">
                    <div class="alert alert-warning" role="alert" invisible="state != 'cancel'">
                        Esta compra está cancelada y no cubre demanda. Si vuelve a borrador, estas cantidades vuelven a contar como comprometidas.
                    </div>
                    <field name="kai_allocation_ids" readonly="1">
                        <list create="false" edit="false" delete="false">
                            <field name="sale_order_id"/>
                            <field name="sale_line_id"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                            <field name="product_uom_id"/>
                            <field name="purchase_state"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
