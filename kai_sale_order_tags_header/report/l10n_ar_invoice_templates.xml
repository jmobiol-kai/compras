<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Loaded only when l10n_ar is installed. The legal header (letter,
         number, CUIT, IIBB) stays in l10n_ar.custom_header. Customer data
         moves under it so it repeats. Vendor bills keep the block in the body.
         Priority 99: after l10n_ar_ux additions inside informations. -->
    <template id="l10n_ar_report_invoice_repeat_header" inherit_id="l10n_ar.report_invoice_document" priority="99">
        <xpath expr="//t[@t-call='web.external_layout']/*[1]" position="before">
            <t t-set="kai_sale_header" t-value="o.is_sale_document(include_receipts=True)"/>
        </xpath>
        <xpath expr="//div[@id='informations']" position="after">
            <t t-set="kai_sale_informations">
                <div id="kai_ar_invoice_informations_anchor"/>
            </t>
            <t t-if="not kai_sale_header">
                <t t-out="kai_sale_informations"/>
            </t>
        </xpath>
        <xpath expr="//div[@id='kai_ar_invoice_informations_anchor']" position="replace">
            <xpath expr="//div[@id='informations']" position="move"/>
        </xpath>
    </template>

    <template id="l10n_ar_custom_header_repeat" inherit_id="l10n_ar.custom_header" priority="99">
        <xpath expr="//div[hasclass('mb-3')]" position="after">
            <div t-if="kai_sale_header" name="kai_sale_repeat" style="font-size: 11px; line-height: 1.2; margin-top: 1mm; padding-bottom: 1mm; border-bottom: 0.3mm solid #212529;">
                <t t-out="kai_sale_informations"/>
            </div>
        </xpath>
    </template>
</odoo>
