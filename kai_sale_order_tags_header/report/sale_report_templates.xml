<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Show sale order tags (Etiquetas) next to the quotation/order number on the PDF -->
    <template id="report_saleorder_document_tags" inherit_id="sale.report_saleorder_document">
        <xpath expr="//t[@t-set='layout_document_title']/span[@t-field='doc.name']" position="after">
            <t t-if="doc.tag_ids">
                <t t-set="kai_tag_palette" t-value="['#6c757d', '#F06050', '#F4A460', '#F7CD1F', '#6CC1ED', '#814968', '#EB7E7F', '#2C8397', '#475577', '#D6145F', '#30C381', '#9365B8']"/>
                <t t-foreach="doc.tag_ids" t-as="kai_tag">
                    <span class="kai_so_tag"
                          t-att-style="'display: inline-block; margin-left: 6px; padding: 2px 8px; border-radius: 10px; font-size: 0.55em; font-weight: normal; vertical-align: middle; color: #ffffff; background-color: %s;' % kai_tag_palette[(kai_tag.color or 0) % 12]"
                          t-out="kai_tag.name"/>
                </t>
            </t>
        </xpath>
    </template>
    <!-- Show contact phone + secondary contact / delivery address phone under the customer address.
         Tel.            : customer (commercial partner) phone
         Tel. contacto   : order contact when it is a child contact of the customer, or, when the order
                           is addressed to the company itself, its first secondary contact with a phone
         Tel. entrega    : delivery address (partner_shipping_id) phone when it is another partner
         The same number is never printed twice. -->
    <template id="report_saleorder_document_phones" inherit_id="sale.report_saleorder_document">
        <xpath expr="//t[@t-set='address']" position="inside">
            <t t-set="kai_main" t-value="doc.partner_id.commercial_partner_id"/>
            <t t-set="kai_sec" t-value="doc.partner_id if doc.partner_id != kai_main else kai_main.child_ids.filtered_domain([('type', '=', 'contact'), ('phone', '!=', False)])[:1]"/>
            <t t-set="kai_ship" t-value="doc.partner_shipping_id"/>
            <t t-set="kai_main_ph" t-value="kai_main.phone or False"/>
            <t t-set="kai_sec_ph" t-value="kai_sec and kai_sec.phone and kai_sec.phone != kai_main_ph and kai_sec.phone or False"/>
            <t t-set="kai_ship_ph" t-value="kai_ship and kai_ship not in (kai_main | doc.partner_id) and kai_ship.phone and kai_ship.phone not in (kai_main_ph, kai_sec_ph) and kai_ship.phone or False"/>
            <p t-if="kai_main_ph" class="mb-0 kai_so_phone">
                <strong>Tel.:</strong> <span t-out="kai_main_ph"/>
            </p>
            <p t-if="kai_sec_ph" class="mb-0 kai_so_phone">
                <strong>Tel. contacto:</strong> <span t-out="kai_sec_ph"/>
                <span class="text-muted">(<t t-out="kai_sec.name"/>)</span>
            </p>
            <p t-if="kai_ship_ph" class="mb-0 kai_so_phone">
                <strong>Tel. entrega:</strong> <span t-out="kai_ship_ph"/>
                <span class="text-muted">(<t t-out="kai_ship.name"/>)</span>
            </p>
        </xpath>
    </template>
</odoo>
