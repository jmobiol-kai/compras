<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Show sale order tags (Etiquetas) next to the quotation/order number on the PDF -->
    <template id="report_saleorder_document_tags" inherit_id="sale.report_saleorder_document">
        <xpath expr="//t[@t-set='layout_document_title']/span[@t-field='doc.name']" position="after">
            <t t-if="doc.tag_ids">
                <t t-set="kai_tag_palette" t-value="['#6c757d', '#F06050', '#F4A460', '#F7CD1F', '#6CC1ED', '#814968', '#EB7E7F', '#2C8397', '#475577', '#D6145F', '#30C381', '#9365B8']"/>
                <t t-foreach="doc.tag_ids" t-as="kai_tag">
                    <span class="kai_so_tag"
                          t-att-style="'display: inline-block; max-width: 240px; margin: 0 0 2px 6px; padding: 1px 8px; border-radius: 10px; font-size: 10px; font-weight: normal; line-height: 1.3; vertical-align: middle; white-space: normal; color: #ffffff; background-color: %s;' % kai_tag_palette[(kai_tag.color or 0) % 12]"
                          t-out="kai_tag.name"/>
                </t>
            </t>
        </xpath>
    </template>
    <!-- Show contact phone + secondary contact / delivery address phone under the customer address.
         Tel.            : customer (commercial partner) phone
         Tel. contacto   : order contact when it is a child contact of the customer, or, when the order
                           is addressed to the company itself, its first secondary contact with a phone
         Tel. entrega    : delivery address (partner_shipping_id) phone when it is another partner
         The same number is never printed twice. -->
    <template id="report_saleorder_document_phones" inherit_id="sale.report_saleorder_document">
        <xpath expr="//t[@t-set='address']" position="inside">
            <t t-set="kai_main" t-value="doc.partner_id.commercial_partner_id"/>
            <t t-set="kai_sec" t-value="doc.partner_id if doc.partner_id != kai_main else kai_main.child_ids.filtered_domain([('type', '=', 'contact'), ('phone', '!=', False)])[:1]"/>
            <t t-set="kai_ship" t-value="doc.partner_shipping_id"/>
            <t t-set="kai_main_ph" t-value="kai_main.phone or False"/>
            <t t-set="kai_sec_ph" t-value="kai_sec and kai_sec.phone and kai_sec.phone != kai_main_ph and kai_sec.phone or False"/>
            <t t-set="kai_ship_ph" t-value="kai_ship and kai_ship not in (kai_main | doc.partner_id) and kai_ship.phone and kai_ship.phone not in (kai_main_ph, kai_sec_ph) and kai_ship.phone or False"/>
            <p t-if="kai_main_ph" class="mb-0 kai_so_phone">
                <strong>Tel.:</strong> <span t-out="kai_main_ph"/>
            </p>
            <p t-if="kai_sec_ph" class="mb-0 kai_so_phone">
                <strong>Tel. contacto:</strong> <span t-out="kai_sec_ph"/>
                <span class="text-muted">(<t t-out="kai_sec.name"/>)</span>
            </p>
            <p t-if="kai_ship_ph" class="mb-0 kai_so_phone">
                <strong>Tel. entrega:</strong> <span t-out="kai_ship_ph"/>
                <span class="text-muted">(<t t-out="kai_ship.name"/>)</span>
            </p>
        </xpath>
    </template>
    <!-- Core prints commitment_date with widget "date", which drops the time
         (22:00 UTC becomes "03/11/2026" instead of "03/11/2026 19:00").
         Quotation, order and proforma all call this template. Keep the
         "Delivery Date" / "Fecha de entrega" label. Pin the timezone so a
         mail or cron render (often UTC, no user tz) still shows the
         salesperson's clock, falling back to Argentina. -->
    <template id="report_saleorder_document_delivery_datetime" inherit_id="sale.report_saleorder_document">
        <xpath expr="//div[@name='delivery_date']/div[@t-field='doc.commitment_date']" position="attributes">
            <attribute name="t-options">{'widget': 'datetime', 'format': 'dd/MM/yyyy HH:mm', 'tz_name': doc.user_id.tz or 'America/Argentina/Buenos_Aires'}</attribute>
        </xpath>
    </template>

    <!--
        Priority 32: after sale_stock (incoterm) and the datetime option above.
        The informations block (dates, salesperson, incoterm) is captured into
        a variable and printed from the header, so wkhtmltopdf repeats it.
        The nodes stay in this template, which keeps their translations.
    -->
    <template id="report_saleorder_document_repeat_header" inherit_id="sale.report_saleorder_document" priority="32">
        <xpath expr="//t[@t-call='web.external_layout']" position="inside">
            <t t-set="kai_sale_header" t-value="True"/>
        </xpath>
        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="class">row mb-0 mt-1 kai_sale_informations</attribute>
        </xpath>
        <xpath expr="//div[@id='informations']" position="after">
            <t t-set="kai_sale_informations">
                <div id="kai_sale_informations_anchor"/>
            </t>
        </xpath>
        <xpath expr="//div[@id='kai_sale_informations_anchor']" position="replace">
            <xpath expr="//div[@id='informations']" position="move"/>
        </xpath>
    </template>

    <!--
        Standard layout only (Happ and Blinis). The customer column and the
        order line are inside div.header, which wkhtmltopdf repeats on every
        page, including a last page that only has totals. Argentine invoices
        set a custom header, and the localization hides this block in that
        case; their adapter prints the customer data under the legal header.
    -->
    <template id="external_layout_standard_sale_header" inherit_id="web.external_layout_standard">
        <xpath expr="//div[@name='company_address']" position="after">
            <div t-if="kai_sale_header" name="kai_sale_customer" class="col-6" style="font-size: 11px; line-height: 1.15;">
                <t t-out="address"/>
                <div t-if="information_block" style="margin-top: 1mm;">
                    <t t-out="information_block"/>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[@name='company_address']/.." position="after">
            <div t-if="kai_sale_header" name="kai_sale_repeat" style="font-size: 11px; line-height: 1.2; margin-top: 1mm; padding-bottom: 1mm; border-bottom: 0.3mm solid #212529;">
                <div style="font-size: 13px; font-weight: 700; line-height: 1.25;">
                    <t t-out="layout_document_title"/>
                </div>
                <t t-out="kai_sale_informations"/>
            </div>
        </xpath>
        <xpath expr="//t[@t-call='web.address_layout']" position="attributes">
            <attribute name="t-if">not kai_sale_header</attribute>
        </xpath>
        <xpath expr="//h2[@t-out='layout_document_title']" position="attributes">
            <attribute name="t-if">not kai_sale_header</attribute>
        </xpath>
    </template>
</odoo>
