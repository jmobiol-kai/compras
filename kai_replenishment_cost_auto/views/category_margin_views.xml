<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_form_margin" model="ir.ui.view">
        <field name="name">product.category.form.kai.margin</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="kai_margin_defined"/>
                <field name="kai_margin_percent" invisible="not kai_margin_defined"/>
                <field name="kai_surcharge" invisible="not kai_margin_defined"/>
                <field name="kai_effective_margin_percent"/>
                <field name="kai_effective_surcharge"/>
            </field>
        </field>
    </record>

    <record id="product_template_form_suggested_price" model="ir.ui.view">
        <field name="name">product.template.form.kai.suggested.price</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <div name="list_price_uom" position="after">
                <field name="currency_id" invisible="1"/>
                <field name="kai_own_margin"/>
                <field name="kai_margin_percent" invisible="not kai_own_margin"/>
                <field name="kai_surcharge" invisible="not kai_own_margin"/>
                <field name="kai_category_margin_percent" invisible="kai_own_margin"/>
                <field name="kai_category_surcharge" invisible="kai_own_margin"/>
                <field name="kai_suggested_price" widget="monetary"/>
                <field name="kai_price_difference" widget="monetary"/>
                <field name="kai_price_difference_percent"/>
            </div>
        </field>
    </record>

    <record id="view_product_template_suggested_price_list" model="ir.ui.view">
        <field name="name">product.template.list.kai.suggested.price</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Precio sugerido vs. actual" create="false">
                <field name="default_code"/>
                <field name="name"/>
                <field name="categ_id"/>
                <field name="list_price" string="Precio actual"/>
                <field name="kai_suggested_price"/>
                <field name="kai_price_difference"/>
                <field name="kai_price_difference_percent"/>
                <field name="kai_own_margin" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_product_template_suggested_price_search" model="ir.ui.view">
        <field name="name">product.template.search.kai.suggested.price</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="default_code"/>
                <field name="categ_id"/>
                <filter name="own_margin" string="Margen propio" domain="[('kai_own_margin', '=', True)]"/>
                <filter name="category_margin" string="Margen de la categoría" domain="[('kai_own_margin', '=', False)]"/>
                <group>
                    <filter name="group_categ" string="Categoría" context="{'group_by': 'categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_kai_suggested_price" model="ir.actions.act_window">
        <field name="name">Precio sugerido vs. actual</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_product_template_suggested_price_list"/>
        <field name="search_view_id" ref="view_product_template_suggested_price_search"/>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p>
                Compara el precio de venta cargado a mano con el precio sugerido
                a partir del costo de reposición y el margen de la categoría.
                No modifica el precio de venta. La lista se puede exportar.
            </p>
        </field>
    </record>

    <record id="view_kai_category_margin_import_form" model="ir.ui.view">
        <field name="name">kai.category.margin.import.form</field>
        <field name="model">kai.category.margin.import</field>
        <field name="arch" type="xml">
            <form string="Importar márgenes por categoría">
                <group>
                    <field name="data" placeholder="Bebidas;35;10&#10;Bebidas / Gaseosas;40"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Importar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kai_category_margin_import" model="ir.actions.act_window">
        <field name="name">Importar márgenes por categoría</field>
        <field name="res_model">kai.category.margin.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_kai_suggested_price"
              name="Precio sugerido vs. actual"
              parent="stock.menu_stock_inventory_control"
              action="action_kai_suggested_price"
              sequence="30"/>

    <menuitem id="menu_kai_category_margin_import"
              name="Importar márgenes por categoría"
              parent="stock.menu_product_in_config_stock"
              action="action_kai_category_margin_import"
              sequence="25"
              groups="stock.group_stock_manager"/>
</odoo>
