<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Own privilege so it is not mixed with Point of Sale User/Administrator
         (those are mutually exclusive in the same privilege). A privilege with
         a single group is shown as a selection on the user form, under Sales.
         Groups without a privilege only appear as checkboxes in debug mode. -->
    <record id="res_groups_privilege_pos_payment_journal_report" model="res.groups.privilege">
        <field name="name">Pagos por método y diario</field>
        <field name="sequence">22</field>
        <field name="category_id" ref="base.module_category_sales"/>
        <field name="placeholder">No</field>
        <field name="description">Permite ver el informe de pagos de PdV agrupados por punto de venta, diario de facturación (Ventas FE / Ventas X) y método de pago. No otorga el resto de permisos del Punto de venta.</field>
    </record>

    <record id="group_pos_payment_journal_report" model="res.groups">
        <field name="name">Ver reporte de pagos por método y diario</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_pos_payment_journal_report"/>
        <field name="comment">Acceso al informe Pagos por método y diario. Hay que asignarlo de a un usuario; no lo implican los grupos del Punto de venta.</field>
        <!-- Only admin on install/upgrade, so someone can see and assign the report. -->
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Report-only users need the PdV root menu, otherwise the report entry
         under Reportes is unreachable. Other PdV menus stay limited to PoS
         groups so this does not open Orders, products or the other reports. -->
    <record id="point_of_sale.menu_point_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('group_pos_payment_journal_report'))]"/>
    </record>
    <record id="point_of_sale.menu_point_of_sale" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('point_of_sale.group_pos_user')), (4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>
    <record id="point_of_sale.pos_config_menu_catalog" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('point_of_sale.group_pos_user')), (4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>
    <record id="point_of_sale.menu_pos_dashboard" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('point_of_sale.group_pos_user')), (4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>
    <record id="point_of_sale.menu_report_daily_details" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('point_of_sale.group_pos_user')), (4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>
    <record id="point_of_sale.menu_report_pos_order_all" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('point_of_sale.group_pos_user')), (4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>
    <record id="point_of_sale.menu_report_order_details" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('point_of_sale.group_pos_user')), (4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>
</odoo>
