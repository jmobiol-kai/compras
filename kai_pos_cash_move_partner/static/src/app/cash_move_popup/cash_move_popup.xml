<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="kai_pos_cash_move_partner.CashMovePopup" t-inherit="point_of_sale.CashMovePopup" t-inherit-mode="extension">
        <xpath expr="//Dialog" position="attributes">
            <attribute name="size">lg</attribute>
        </xpath>
        <xpath expr="//textarea[@id='reason']/parent::div" position="after">
            <div class="kai-cash-move-partner mt-3 d-flex flex-column gap-2">
                <div class="kai-partner-combobox">
                    <label class="form-label mb-1" for="kai_cash_move_partner">Contacto</label>
                    <SelectMenu
                        t-key="state.type"
                        id="'kai_cash_move_partner'"
                        class="'w-100'"
                        choices="state.partnerChoices"
                        value="state.partnerId"
                        placeholder="'Buscar contacto...'"
                        searchPlaceholder="'Buscar contacto...'"
                        onInput.bind="onPartnerSearch"
                        onSelect.bind="onPartnerSelect"/>
                </div>

                <div t-if="state.partnerId and !state.destJournalId and (state.loadingMoves or state.moves.length)">
                    <div class="form-label mb-1">Facturas</div>
                    <div t-if="state.loadingMoves" class="text-muted small">Cargando facturas...</div>
                    <div t-if="state.moves.length" class="kai-cash-move-options d-flex flex-column gap-1">
                        <div t-foreach="state.moves" t-as="move" t-key="move.id" class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   t-att-id="'kai_cash_move_' + move.id"
                                   t-att-checked="this.isMoveSelected(move.id)"
                                   t-on-change="() => this.toggleMove(move.id)"/>
                            <label class="form-check-label" t-att-for="'kai_cash_move_' + move.id">
                                <t t-esc="move.name"/>
                                <t t-if="move.invoice_date"> · <t t-esc="move.invoice_date"/></t>
                                · <t t-esc="move.amount_residual_display"/>
                                <span t-if="move.payment_state === 'partial'" class="text-muted"> (parcial)</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div t-if="this.showOnAccount() and state.type === 'in'" class="text-muted small">
                    <span class="fw-semibold">Pago a cuenta</span>.
                    Se genera un recibo del cliente. El motivo queda en el memo y se puede imputar después.
                    <t t-if="!state.moves.length"> No hay facturas abiertas.</t>
                    <t t-else=""> Si no elegís facturas, no se imputan ahora.</t>
                </div>
                <div t-if="this.showOnAccount() and state.type !== 'in'" class="text-muted small">
                    <span class="fw-semibold">Pago a cuenta</span>
                    <t t-if="!state.moves.length">. No hay facturas abiertas.</t>
                    <t t-else="">. Si no elegís facturas, el monto queda a cuenta de este contacto.</t>
                </div>
                <div t-if="state.partnerId and !state.destJournalId and state.selectedMoveIds.length" class="text-muted small">
                    Se aplica primero a la más vieja. Lo que sobre queda como pago a cuenta.
                </div>

                <div>
                    <label class="form-label mb-1" t-att-for="this.showDestJournal() ? 'kai_cash_move_journal' : false">Diario destino</label>
                    <select t-if="this.showDestJournal()"
                            id="kai_cash_move_journal"
                            class="form-select"
                            t-key="state.type"
                            t-att-value="state.destJournalId || ''"
                            t-on-change="onDestJournalChange">
                        <option value="" t-att-selected="!state.destJournalId"><t t-esc="state.sessionCashJournalName"/></option>
                        <option t-foreach="state.journals"
                                t-as="journal"
                                t-key="journal.id"
                                t-att-value="journal.id"
                                t-att-selected="state.destJournalId === journal.id">
                            <t t-esc="journal.name"/>
                        </option>
                    </select>
                    <div t-else="" id="kai_cash_move_journal_locked" class="text-muted small">Elegí un contacto para poder elegir el diario.</div>
                </div>
                <div t-if="state.destJournalId and this.showDestJournal()" class="text-muted small">
                    La plata pasa a ese diario. No se aplican facturas.
                </div>
            </div>
        </xpath>
    </t>

</templates>
